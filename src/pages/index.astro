      flex-direction: column;
      justify-content: center;
      background: var(--chev-bg);
      color: var(--chev-fg);
      /* Overhang the next column so this point fills that chevron's notch. */
      margin-right: calc(var(--notch) * -1);
      padding: 20px calc(var(--notch) + 14px) 20px calc(var(--notch) + 16px);
      clip-path: polygon(
        0 0,
        calc(100% - var(--notch)) 0,
        100% 50%,
        calc(100% - var(--notch)) 100%,
        0 100%,
        var(--notch) 50%
