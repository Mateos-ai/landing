  .silo-chip { fill: var(--cst-bg); stroke: var(--border-strong); stroke-width: 1; }
  .silo-chip-text {
    fill: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
  }

  /* The attempt: a line that stops short, and value that evaporates on the way. */
  .silo-line {
    stroke: var(--border-strong);
    stroke-width: 1.4;
    stroke-dasharray: 5 6;
    opacity: 0.75;
    fill: none;
  }
  .silo-dot {
    fill: var(--amber-500);
    opacity: 0;
    animation: siloDrift 2.6s ease-in infinite;
  }
  @keyframes siloDrift {
    0%   { transform: translate(0, 0); opacity: 0; }
    18%  { opacity: 1; }
    72%  { opacity: 0.4; }
    100% { transform: translate(var(--dx), var(--dy)); opacity: 0; }
  }

  /* The void: an empty ring where the shared layer should be. */
  .silo-core {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.6;
    stroke-dasharray: 6 8;
    opacity: 0.7;
    transform-box: fill-box;
    transform-origin: center;
    animation: siloSpin 30s linear infinite;
