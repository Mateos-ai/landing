---

<Layout>
  <!-- ── NAVBAR ──────────────────────────────────────────────────────── -->
  <header>
    <div class="wrap bar">
      <a href="/" class="brand" aria-label="Mateos.ai home">
        <img src="/mateos-logo.svg" alt="" class="brand-mark" />
        <span class="brand-name">mateos<span class="brand-ai">.ai</span></span>
      </a>

      <div class="nav-right">
        <a href="#cta" class="btn-cta">Book a Diagnosis</a>
        <div class="theme-picker" id="theme-picker">
          <button class="theme-trigger" id="theme-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Color theme">
            <span class="theme-icon" id="theme-icon"></span>
          </button>
          <ul class="theme-dropdown" role="listbox" id="theme-dropdown">
            <li class="theme-opt" role="option" data-value="system">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              System
            </li>
            <li class="theme-opt" role="option" data-value="light">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              Light
            </li>
            <li class="theme-opt" role="option" data-value="dark">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              Dark
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ── HERO ───────────────────────────────────────────────────────── -->
    <section class="hero" id="product">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <img src="/mateos-logo-secondary.svg" alt="" class="hero-logo" />
        <h1><span class="brand-text">Your</span><br /><span class="gradient-text">AI Partner</span></h1>
        <p class="hero-tagline">From diagnosis to execution, end to end.</p>
        <p class="hero-sub">AI is arriving in your organization in silos. We connect it into one intelligence layer, built on the tools you already use, and take you from stage one of AI to stage ten.</p>
        <div class="hero-actions">
          <a href="#thesis" class="btn-ghost-lg btn-ghost-animated">See How It Works ↓</a>
        </div>
      </div>
    </section>

    <!-- ── THESIS ─────────────────────────────────────────────────────── -->
    <section class="thesis-section" id="thesis">
      <div class="wrap thesis-inner" data-reveal>
        <h2>Your People Use AI in <span class="gradient-text">Silos</span></h2>
        <p class="thesis-lead">ChatGPT in one corner. AI inside the CRM in another. Something else in sales, something else in R&amp;D. None of it talks to each other, so the value stays trapped.</p>
      </div>

      <div class="wrap">
        <div class="silo-viz" data-reveal>
          <svg class="silo-wide" viewBox="0 0 900 340" role="img" aria-label="Four departments, each running its own AI, with nothing connecting them in the middle.">
            {silos.map((s, i) => {
              const f = siloFlow(s.x, s.y, SILO_CORE, 88);
              return (
                <>
                  <line class="silo-line" x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} />
                  {[0, 1].map((d) => (
                    <circle
                      class="silo-dot"
                      cx={f.x1}
                      cy={f.y1}
                      r="4.4"
                      style={`--dx:${f.tx}px; --dy:${f.ty}px; animation-delay:${(i * 0.35 + d * 1.3).toFixed(2)}s`}
                    />
                  ))}
                </>
              );
            })}

            <circle class="silo-core" cx={SILO_CORE.x} cy={SILO_CORE.y} r={SILO_CORE.r} />
            <text class="silo-core-label" x={SILO_CORE.x} y={SILO_CORE.y + SILO_CORE.r + 26} text-anchor="middle">No shared layer</text>

            {silos.map((s) => (
              <g>
                <rect class="silo-box" x={s.x - 75} y={s.y - 60} width="150" height="120" rx="16" />
                <rect class="silo-tile" x={s.x - 21} y={s.y - 46} width="42" height="42" rx="11" />
                <image href={s.src} x={s.x - 14} y={s.y - 39} width="28" height="28" preserveAspectRatio="xMidYMid meet" />
                <text class="silo-label" x={s.x} y={s.y + 20} text-anchor="middle">{s.label}</text>
                <rect class="silo-chip" x={s.x - 31} y={s.y + 30} width="62" height="20" rx="10" />
                <text class="silo-chip-text" x={s.x} y={s.y + 44} text-anchor="middle">OWN AI</text>
              </g>
            ))}
          </svg>

          <svg class="silo-tall" viewBox="0 0 400 520" role="img" aria-label="Four departments, each running its own AI, with nothing connecting them in the middle.">
            {silos.map((s, i) => {
              const f = siloFlow(s.mx, s.my, SILO_CORE_M, 76);
              return (
                <>
                  <line class="silo-line" x1={f.x1} y1={f.y1} x2={f.x2} y2={f.y2} />
                  {[0, 1].map((d) => (
                    <circle
                      class="silo-dot"
                      cx={f.x1}
                      cy={f.y1}
                      r="4.2"
                      style={`--dx:${f.tx}px; --dy:${f.ty}px; animation-delay:${(i * 0.35 + d * 1.3).toFixed(2)}s`}
                    />
                  ))}
                </>
              );
            })}

            <circle class="silo-core" cx={SILO_CORE_M.x} cy={SILO_CORE_M.y} r={SILO_CORE_M.r} />
            <text class="silo-core-label silo-core-label-sm" x={SILO_CORE_M.x} y={SILO_CORE_M.y + SILO_CORE_M.r + 24} text-anchor="middle">No shared layer</text>

            {silos.map((s) => (
              <g>
                <rect class="silo-box" x={s.mx - 84} y={s.my - 59} width="168" height="118" rx="16" />
                <rect class="silo-tile" x={s.mx - 21} y={s.my - 45} width="42" height="42" rx="11" />
                <image href={s.src} x={s.mx - 14} y={s.my - 38} width="28" height="28" preserveAspectRatio="xMidYMid meet" />
                <text class="silo-label" x={s.mx} y={s.my + 21} text-anchor="middle">{s.label}</text>
                <rect class="silo-chip" x={s.mx - 31} y={s.my + 31} width="62" height="20" rx="10" />
                <text class="silo-chip-text" x={s.mx} y={s.my + 45} text-anchor="middle">OWN AI</text>
              </g>
            ))}
          </svg>
        </div>
      </div>

      <div class="wrap thesis-inner thesis-outro" data-reveal>
        <p class="thesis-lead">We do the harder, more valuable thing: <strong class="gradient-text">we connect it.</strong> We build the intelligence layer that lets your whole organization learn, and we take you from stage one of AI to stage ten.</p>
      </div>
    </section>

    <!-- ── COMPANY BRAIN ──────────────────────────────────────────────── -->
    <section class="brain-section" id="brain">
      <div class="wrap">
        <div class="section-header" data-reveal>
          <h2>Not just point solutions.<br /><span class="gradient-text">One Company Brain.</span></h2>
          <p class="section-sub">Automation and AI tools each solve one thing and stop there. We connect your systems into a single brain, then put agents on top of it, so what one team learns, the whole company knows.</p>
        </div>

        <div class="constellation" data-reveal>
          <svg class="cst-wide" viewBox="0 0 900 520" role="img" aria-label="Your systems connect into one Company Brain that powers trusted agents, each with evals.">
            <defs>
              <filter id="cstShadow" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="3" stdDeviation="6" flood-color="#14141e" flood-opacity="0.14" />
              </filter>
            </defs>

            <!-- connectors: systems -> brain -->
            {brainSources.map((s, i) => (
              <>
                <line class="cst-line-base" x1={s.x} y1={s.y} x2={CORE.x} y2={CORE.y} />
                <line class="cst-line-flow" x1={s.x} y1={s.y} x2={CORE.x} y2={CORE.y} style={`animation-delay:${(i * 0.13).toFixed(2)}s`} />
              </>
            ))}

            <!-- connectors: brain -> agents -->
            {brainAgents.map((a, i) => (
              <>
                <line class="cst-line-base" x1={CORE.x} y1={CORE.y} x2={a.x} y2={a.y} />
                <line class="cst-line-flow out" x1={CORE.x} y1={CORE.y} x2={a.x} y2={a.y} style={`animation-delay:${(i * 0.2).toFixed(2)}s`} />
              </>
            ))}

            <!-- brain glow -->
            <circle class="cst-core-glow" cx={CORE.x} cy={CORE.y} r={R_CORE} />

            <!-- system tiles -->
            {brainSources.map((s) => (
              <g filter="url(#cstShadow)">
                <rect class="cst-tile" x={s.x - TILE / 2} y={s.y - TILE / 2} width={TILE} height={TILE} rx="14" />
                <image href={s.src} x={s.x - TILE / 2 + 11} y={s.y - TILE / 2 + 11} width={TILE - 22} height={TILE - 22} preserveAspectRatio="xMidYMid meet" />
              </g>
            ))}

            <!-- brain -->
            <g filter="url(#cstShadow)">
              <circle class="cst-core" cx={CORE.x} cy={CORE.y} r={R_CORE} />
              <g transform="translate(421,221) scale(0.39)">
                <circle cx="130" cy="70" r="27" fill="#FF8C42" />
                <circle cx="70" cy="130" r="27" fill="#17BEBB" />
                <circle cx="130" cy="130" r="27" fill="#5B53E8" />
              </g>
            </g>
            <text class="cst-core-label" x={CORE.x} y={CORE.y + R_CORE + 24} text-anchor="middle">Company Brain</text>

            <!-- agents with evals -->
            {brainAgents.map((a) => {
              const w = 176;
              const h = 58;
              const lx = a.x - w / 2;
              const ly = a.y - h / 2;
              return (
                <g filter="url(#cstShadow)">
                  <rect class="cst-agent" x={lx} y={ly} width={w} height={h} rx="14" />
                  <circle class="cst-agent-live" cx={lx + 18} cy={a.y} r="4" />
                  <text class="cst-agent-label" x={lx + 32} y={a.y - 3}>{a.label}</text>
                  <text class="cst-agent-eval" x={lx + 32} y={a.y + 17}>evals() ✓ {a.score}</text>
                </g>
              );
            })}
          </svg>

          <svg class="cst-tall" viewBox="0 0 400 660" role="img" aria-label="Your systems connect into one Company Brain that powers trusted agents, each with evals.">
            <defs>
              <filter id="cstShadowM" x="-40%" y="-40%" width="180%" height="180%">
                <feDropShadow dx="0" dy="3" stdDeviation="6" flood-color="#14141e" flood-opacity="0.14" />
              </filter>
            </defs>

            <!-- connectors: systems -> brain -->
            {brainSources.map((s, i) => (
              <>
                <line class="cst-line-base" x1={s.mx} y1={s.my} x2={CORE_M.x} y2={CORE_M.y} />
                <line class="cst-line-flow" x1={s.mx} y1={s.my} x2={CORE_M.x} y2={CORE_M.y} style={`animation-delay:${(i * 0.13).toFixed(2)}s`} />
              </>
            ))}

            <!-- connectors: brain -> agents -->
            {brainAgents.map((a, i) => (
              <>
                <line class="cst-line-base" x1={CORE_M.x} y1={CORE_M.y} x2={a.mx} y2={a.my} />
                <line class="cst-line-flow out" x1={CORE_M.x} y1={CORE_M.y} x2={a.mx} y2={a.my} style={`animation-delay:${(i * 0.2).toFixed(2)}s`} />
              </>
            ))}

            <circle class="cst-core-glow" cx={CORE_M.x} cy={CORE_M.y} r={R_CORE_M} />

            {brainSources.map((s) => (
              <g filter="url(#cstShadowM)">
                <rect class="cst-tile" x={s.mx - TILE_M / 2} y={s.my - TILE_M / 2} width={TILE_M} height={TILE_M} rx="13" />
                <image href={s.src} x={s.mx - TILE_M / 2 + 10} y={s.my - TILE_M / 2 + 10} width={TILE_M - 20} height={TILE_M - 20} preserveAspectRatio="xMidYMid meet" />
              </g>
            ))}

            <g filter="url(#cstShadowM)">
              <circle class="cst-core" cx={CORE_M.x} cy={CORE_M.y} r={R_CORE_M} />
              <g transform="translate(167,287) scale(0.33)">
                <circle cx="130" cy="70" r="27" fill="#FF8C42" />
                <circle cx="70" cy="130" r="27" fill="#17BEBB" />
                <circle cx="130" cy="130" r="27" fill="#5B53E8" />
              </g>
            </g>
            <text class="cst-core-label cst-core-label-sm" x={CORE_M.x} y={CORE_M.y + R_CORE_M + 22} text-anchor="middle">Company Brain</text>

            {brainAgents.map((a) => {
              const w = 260;
              const h = 54;
              const lx = a.mx - w / 2;
              const ly = a.my - h / 2;
              return (
                <g filter="url(#cstShadowM)">
                  <rect class="cst-agent" x={lx} y={ly} width={w} height={h} rx="13" />
                  <circle class="cst-agent-live" cx={lx + 18} cy={a.my} r="4" />
                  <text class="cst-agent-label" x={lx + 32} y={a.my - 3}>{a.label}</text>
                  <text class="cst-agent-eval" x={lx + 32} y={a.my + 16}>evals() ✓ {a.score}</text>
                </g>
              );
            })}
          </svg>
        </div>
      </div>
    </section>

    <!-- ── WHAT WE DO ─────────────────────────────────────────────────── -->
