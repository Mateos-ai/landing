<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));

  // Focus email input helper
  function focusEmailInput() {
    const input = document.querySelector('.early-input');
    if (!input) return;
    const ctaSection = document.getElementById('cta');
    ctaSection?.scrollIntoView({ behavior: 'smooth' });
    setTimeout(() => input.focus(), 500);
  }

  document.querySelector('.btn-cta')?.addEventListener('click', (e) => {
    e.preventDefault();
    focusEmailInput();
  });
</script>

<script define:vars={{ web3formsKey: import.meta.env.PUBLIC_WEB3FORMS_KEY }}>
  // Web3Forms emails every submission to the address its access key is registered to
  // (support@mateos.ai). Free key from https://web3forms.com; set PUBLIC_WEB3FORMS_KEY at build time.
  async function submitEmail(email) {
    if (!web3formsKey) {
      console.error('[diagnosis] Web3Forms key missing - set PUBLIC_WEB3FORMS_KEY at build time.');
      return false;
    }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 15000);
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({
          access_key: web3formsKey,
          subject: 'New diagnosis request (mateos.ai)',
          from_name: 'mateos.ai landing',
          email,
        }),
        signal: controller.signal,
      });
      const json = await res.json().catch(() => null);
      if (res.ok && json?.success) return true;
      console.error(`[diagnosis] submit failed: ${res.status}`, json);
      return false;
    } catch (err) {
      console.error('[diagnosis] request failed (network/blocked/timeout):', err);
      return false;
    } finally {
      clearTimeout(timeout);
    }
  }

  const CHECK_SVG = `<svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52"><circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/><path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/></svg>`;

  function wireForm(formId, successId) {
    const form = document.getElementById(formId);
    const success = document.getElementById(successId);
    if (!form) return;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]');
      const btn = form.querySelector('button');
      const email = input.value.trim();
      if (!email) { input.focus(); return; }
      btn.disabled = true;
      btn.textContent = 'Saving...';
      const ok = await submitEmail(email);
      if (ok) {
        input.style.transition = 'opacity 0.3s, width 0.35s, padding 0.35s, margin 0.35s';
        input.style.opacity = '0';
        input.style.width = '0';
        input.style.padding = '0';
        input.style.margin = '0';
        btn.innerHTML = CHECK_SVG;
        btn.classList.add('is-success');
        if (success) {
          setTimeout(() => { success.hidden = false; }, 400);
        }
      } else {
        btn.disabled = false;
        btn.textContent = 'Try again';
      }
    });
  }

  wireForm('form-hero', 'success-hero');
  wireForm('form-cta', 'success-cta');
</script>

