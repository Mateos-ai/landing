  .silo-box { fill: var(--silo-fill); stroke: var(--border); stroke-width: 1.2; }
  .silo-tile { fill: #ffffff; stroke: rgba(20,20,30,0.08); stroke-width: 1; }
  .silo-label {
    fill: var(--text-primary);
    font-family: var(--font-body);
