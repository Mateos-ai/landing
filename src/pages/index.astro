---
import Layout from "@/layouts/Layout.astro";
import BrowserFrame from "@/components/BrowserFrame.astro";

const SVC_ICON = {
  network: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
  user: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  search: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>`,
  zap: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  check: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
  calendar: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>`,
};

const services = [
  {
    icon: SVC_ICON.search,
    title: "AI Diagnosis",
    body: "Our software and our senior team map your organization and your data, then show you exactly where AI pays off first. Every engagement starts here.",
    color: "amber",
  },
  {
    icon: SVC_ICON.zap,
    title: "Agents on Your Tools",
    body: "AI agents deployed on the stack you already run: sales, service, finance, operations. No new platforms, no rip and replace.",
    color: "teal",
  },
  {
    icon: SVC_ICON.network,
    title: "The Organizational Brain",
    body: "The connected, cross-department build that ties your systems together. What one team learns, the whole company knows.",
    color: "indigo",
  },
  {
    icon: SVC_ICON.user,
    title: "Fractional Chief AI Officer",
    body: "A Chief AI Officer backed by our entire team, R&D and tooling. Senior AI leadership for less than the cost of a single hire.",
    color: "amber",
  },
  {
    icon: SVC_ICON.check,
    title: "Projects",
    body: "Fixed scope, from focused pilot to full build. We size the project to the problem and deliver it end to end.",
    color: "teal",
  },
  {
    icon: SVC_ICON.calendar,
    title: "Workshops",
    body: "Hands-on sessions built around your own workflows and data. The fastest way for your team to see what AI can actually do.",
    color: "indigo",
  },
];

const howSteps = [
  {
    num: "01",
    title: "Start at the sharpest pain",
    body: "Whatever hurts most, sales, service or HR, that is where we begin. It is what you actually came for.",
  },
  {
    num: "02",
    title: "Solve today, build for tomorrow",
    body: "We fix the immediate need in a way that quietly lays the groundwork for the broader, connected solution.",
  },
  {
    num: "03",
    title: "Own it end to end",
    body: "Business strategy and execution, both. We do not hand off a slide deck. We build it and we run it with you.",
  },
  {
    num: "04",
    title: "Every project compounds",
    body: "A solution built once becomes a tool your organization keeps. That is exactly how our Sales Magician was born.",
  },
];

const teamLogos = [
  {
    label: "Google",
    svg: `<svg width="100" height="100" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
      <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
      <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
      <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
    </svg>`,
  },
  {
    label: "MIT",
    svg: `<svg width="160" height="100" viewBox="0 0 160 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <text x="80" y="62" font-family="Georgia,serif" font-weight="700" font-size="52" fill="#A31F34" text-anchor="middle">MIT</text>
    </svg>`,
  },
  {
    label: "Slack",
    svg: `<svg width="100" height="100" viewBox="0 0 127 127" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path d="M27.2 80c0 7.3-5.9 13.2-13.2 13.2C6.7 93.2.8 87.3.8 80c0-7.3 5.9-13.2 13.2-13.2h13.2V80z" fill="#E01E5A"/>
      <path d="M33.8 80c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V80z" fill="#E01E5A"/>
      <path d="M47 27c-7.3 0-13.2-5.9-13.2-13.2C33.8 6.5 39.7.6 47 .6c7.3 0 13.2 5.9 13.2 13.2V27H47z" fill="#36C5F0"/>
      <path d="M47 33.8c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H14c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33z" fill="#36C5F0"/>
      <path d="M100 47c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H100V47z" fill="#2EB67D"/>
      <path d="M93.4 47c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V14c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33z" fill="#2EB67D"/>
      <path d="M80.2 100c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V100h13.2z" fill="#ECB22E"/>
      <path d="M80.2 93.4c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2H113c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H80.2z" fill="#ECB22E"/>
    </svg>`,
  },
];
---

<Layout>
  <!-- ── NAVBAR ──────────────────────────────────────────────────────── -->
  <header>
    <div class="wrap bar">
      <a href="/" class="brand" aria-label="Mateos.ai home">
        <img src="/mateos-logo.svg" alt="" class="brand-mark" />
        <span class="brand-name">mateos<span class="brand-ai">.ai</span></span>
      </a>

      <div class="nav-right">
        <a href="#cta" class="btn-cta">Book a Diagnosis</a>
        <div class="theme-picker" id="theme-picker">
          <button class="theme-trigger" id="theme-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Color theme">
            <span class="theme-icon" id="theme-icon"></span>
          </button>
          <ul class="theme-dropdown" role="listbox" id="theme-dropdown">
            <li class="theme-opt" role="option" data-value="system">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              System
            </li>
            <li class="theme-opt" role="option" data-value="light">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              Light
            </li>
            <li class="theme-opt" role="option" data-value="dark">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              Dark
            </li>
          </ul>
        </div>
      </div>
    </div>
  </header>

  <main>
    <!-- ── HERO ───────────────────────────────────────────────────────── -->
    <section class="hero" id="product">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <img src="/mateos-logo-secondary.svg" alt="" class="hero-logo" />
        <h1><span class="brand-text">Your</span><br /><span class="gradient-text">AI Partner</span></h1>
        <p class="hero-tagline">From diagnosis to execution, end to end.</p>
        <p class="hero-sub">AI is arriving in your organization in silos. We connect it into one intelligence layer, built on the tools you already use, and take you from stage one of AI to stage ten.</p>
        <div class="hero-actions">
          <a href="#thesis" class="btn-ghost-lg btn-ghost-animated">See The Magic ↓</a>
        </div>
      </div>
    </section>

    <!-- ── THESIS ─────────────────────────────────────────────────────── -->
    <section class="thesis-section" id="thesis">
      <div class="wrap thesis-inner" data-reveal>
        <h2>Your People Use AI in <span class="gradient-text">Silos</span></h2>
        <p class="thesis-lead">ChatGPT in one corner. AI inside the CRM in another. Something else in sales, something else in R&amp;D. None of it talks to each other, so the value stays trapped.</p>
        <p class="thesis-lead">We do the harder, more valuable thing: <strong class="gradient-text">we connect it.</strong> We build the intelligence layer that lets your whole organization learn, and we take you from stage one of AI to stage ten.</p>
      </div>
    </section>

    <!-- ── WHAT WE DO ─────────────────────────────────────────────────── -->
    <section class="services-section" id="services">
      <div class="wrap">
        <div class="section-header" data-reveal>
          <h2><span class="gradient-text">One partner</span>, end to end</h2>
          <p class="section-sub">Start where it hurts most and grow at your own pace. Everything runs on the tools you already use.</p>
        </div>
        <div class="services-grid">
          {services.map((svc, i) => (
            <article class={`svc-card svc-${svc.color}`} data-reveal data-reveal-delay={String((i % 3) + 1)}>
              <span class="svc-icon" set:html={svc.icon} />
              <h3>{svc.title}</h3>
              <p>{svc.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── HOW WE WORK ────────────────────────────────────────────────── -->
    <section class="how-section" id="how">
      <div class="wrap">
        <div class="section-header" data-reveal>
          <h2>Start small. <span class="gradient-text">Compound</span> fast.</h2>
        </div>
        <div class="how-grid">
          {howSteps.map((step, i) => (
            <article class="how-card" data-reveal data-reveal-delay={String((i % 2) + 1)}>
              <div class="how-num">{step.num}</div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── WHY MATEOS ─────────────────────────────────────────────────── -->
    <section class="why-section" id="why">
      <div class="wrap">
        <div class="section-header" data-reveal>
          <h2><span class="gradient-text">Partner</span>, not vendor</h2>
        </div>
        <div class="why-featured" data-reveal>
          <h3>Results</h3>
          <p>We are not a consulting firm with slide decks. Our own software maps your organization, analyzes your data and recommends the moves, and it powers every agent we deploy. Strategy from senior people, speed and precision from the machine. That combination is the product.</p>
        </div>
        <div class="why-grid">
          <article class="why-card" data-reveal data-reveal-delay="1">
            <div class="why-stat">25%<span class="why-ast">*</span></div>
            <h3>Skin in the game</h3>
            <p>Of our project fee is contingent on hitting the KPIs we agree on together. Miss them, and you pay less. It changes how we build, not just how we sell.</p>
          </article>
          <article class="why-card" data-reveal data-reveal-delay="2">
            <div class="why-stat"><span class="brand-text-purple">Proof</span></div>
            <h3>Earn the big plan</h3>
            <p>You take the first step; we build on it, proving results at each stage, until we're delivering on your biggest plan.</p>
          </article>
        </div>
        <p class="why-footnote">* The exact share depends on the project.</p>
      </div>
    </section>

    <!-- ── CTA ────────────────────────────────────────────────────────── -->
    <section class="cta-section" id="cta">
      <div class="wrap cta-inner" data-reveal>
        <h2><span class="gradient-text">Book a diagnosis</span></h2>
        <p>Tell us where it hurts. We'll map your organization and show you where AI pays off first.</p>
        <form class="early-form" id="form-cta" novalidate>
          <input type="email" class="early-input" placeholder="your@email.com" required autocomplete="email" />
          <button type="submit" class="btn-primary-lg">Book a diagnosis →</button>
        </form>
        <p class="early-success" id="success-cta" hidden>Thank you! We'll reach out to schedule your diagnosis call.</p>
      </div>
    </section>
  </main>

  <!-- ── FOOTER ─────────────────────────────────────────────────────── -->
  <footer>
    <div class="wrap footer-inner">
      <div class="brand" aria-label="Mateos.ai">
        <svg width="22" height="22" viewBox="43 43 114 114" aria-hidden="true">
          <circle cx="130" cy="70" r="27" fill="#FF8C42"/>
          <circle cx="70" cy="130" r="27" fill="#17BEBB"/>
          <circle cx="130" cy="130" r="27" fill="#5B53E8"/>
        </svg>
        <span class="brand-name">mateos<span class="brand-ai">.ai</span></span>
      </div>
      <span class="footer-copy">2026 · © Mateos · All rights reserved.</span>
    </div>
  </footer>
</Layout>

<style>
  /* ── Navbar ──────────────────────────────────────────────────────────── */
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--nav-border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    height: 28px;
    width: auto;
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  @media (min-width: 1024px) { .nav-right .btn-cta { margin-left: 20px; } }
  .btn-cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--on-primary);
    font-weight: 600;
    font-size: 0.875rem;
    padding: 0.5rem 1.1rem;
    border-radius: var(--radius-sm);
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .btn-cta:hover { background: var(--color-primary-hover); transform: translateY(-1px); }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--hero-bg);
    min-height: 100vh;
    padding: 0;
    text-align: center;
    display: flex;
    align-items: center;
  }
  .hero-glow { display: none; }
  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .hero-logo {
    height: 72px;
    width: auto;
    margin-bottom: 8px;
  }
  .hero h1 {
    font-size: clamp(3rem, 8vw, 5.5rem);
    color: var(--hero-heading);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    color: var(--hero-body);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .gradient-text {
    background: var(--gradient-brand);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-sub {
    max-width: 520px;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--hero-body);
  }
  .hero-pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--hero-pill-text);
    border: 1px solid var(--hero-pill-border);
    background: var(--hero-pill-bg);
    padding: 5px 12px;
    border-radius: var(--radius-full);
  }
  .hero-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    margin-top: 8px;
  }
  .early-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .early-input {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 0.95rem;
    width: 220px;
    transition: border-color 0.2s, box-shadow 0.2s;
    outline: none;
  }
  .early-input:focus {
    border-color: var(--amber-500);
    box-shadow: 0 0 0 3px rgba(255,140,66,0.15);
  }
  .early-input::placeholder { color: var(--text-muted); }
  .early-success {
    font-size: 0.95rem;
    color: var(--teal-600);
    font-weight: 500;
    margin-top: 4px;
  }
  :global([data-theme="dark"]) .early-success { color: var(--teal-400); }
  .btn-primary-lg {
    display: inline-block;
    background: var(--color-primary);
    color: var(--on-primary);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.75rem 1.6rem;
    border-radius: var(--radius-sm);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: var(--shadow-md);
  }
  .btn-primary-lg:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
  }
  .btn-primary-lg.is-success {
    background: transparent;
    box-shadow: none;
    border: none;
    padding: 0;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
  }
  .btn-ghost-lg {
    display: inline-block;
    font-size: 0.95rem;
    color: var(--hero-ghost-text);
    padding: 0.75rem 1.2rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--hero-ghost-border);
    transition: border-color 0.3s, color 0.3s;
    position: relative;
    z-index: 0;
  }
  .btn-ghost-lg::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: calc(var(--radius-sm) + 1px);
    padding: 1px;
    background: linear-gradient(90deg, var(--amber-500), var(--teal-500), var(--indigo-500), var(--amber-500));
    background-size: 300% 100%;
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: destination-out;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
    z-index: -1;
  }
  .btn-ghost-lg:hover {
    border-color: transparent;
    background: linear-gradient(90deg, var(--amber-500), var(--teal-500), var(--indigo-500), var(--amber-500));
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: magic-gradient 2s linear infinite;
  }
  .btn-ghost-lg:hover::before {
    opacity: 1;
    animation: magic-gradient 2s linear infinite;
  }
  @keyframes magic-gradient {
    0%   { background-position: 0% 50%; }
    100% { background-position: 300% 50%; }
  }
  :global([data-theme="dark"]) .btn-ghost-lg { color: #FFFFFF; border-color: rgba(255,255,255,0.6); }
  :global([data-theme="dark"]) .btn-ghost-lg:hover { -webkit-text-fill-color: transparent; }
  .btn-ghost-animated {
    border-color: transparent !important;
    background: linear-gradient(90deg, var(--amber-500), var(--teal-500), var(--indigo-500), var(--amber-500));
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: magic-gradient 2s linear infinite;
  }
  .btn-ghost-animated::before {
    opacity: 1 !important;
