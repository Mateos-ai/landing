// Silos: four departments, each with its own AI, none of them connected. The
// flows stop well short of the empty core so "nothing in the middle" reads at a
// glance, which is the setup the Company Brain constellation below pays off.
const SILO_CORE = { x: 450, y: 170, r: 56 };
const SILO_CORE_M = { x: 200, y: 258, r: 46 };

const silos = [
  { label: "Sales",     src: "/salesforce.webp", x: 140, y: 90,  mx: 96,  my: 66  },
  { label: "Support",   src: "/zendesk.webp",    x: 140, y: 250, mx: 304, my: 66  },
  { label: "Marketing", src: "/hubspot.webp",    x: 760, y: 90,  mx: 96,  my: 452 },
  { label: "R&D",       src: "/notion.webp",     x: 760, y: 250, mx: 304, my: 452 },
];

// Where a silo's outbound flow starts (just clear of its box) and dies (a little
// over half the remaining distance to the core, leaving a visible void).
function siloFlow(sx, sy, core, clear) {
  const dx = core.x - sx;
  const dy = core.y - sy;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const stop = clear + (len - core.r - clear) * 0.58;
  return {
    x1: +(sx + ux * clear).toFixed(1),
    y1: +(sy + uy * clear).toFixed(1),
    x2: +(sx + ux * stop).toFixed(1),
    y2: +(sy + uy * stop).toFixed(1),
    tx: +(ux * (stop - clear)).toFixed(1),
    ty: +(uy * (stop - clear)).toFixed(1),
  };
}

