  .how-s2 { --chev-bg: #7FDBDA; --chev-fg: #14141E; --chev-dot: #14888A; }
  .how-s3 { --chev-bg: #A5A0F2; --chev-fg: #14141E; --chev-dot: #433DA9; }
  .how-s4 { --chev-bg: #5049CB; --chev-fg: #FFFFFF; --chev-dot: #5049CB; }

  .how-step {
    /* Scales with width so the V stays proportional from phone to tablet. */
    --notch: clamp(28px, 5.5vw, 60px);
    background: var(--chev-bg);
    color: var(--chev-fg);
    padding: calc(var(--notch) + 20px) 26px;
    clip-path: polygon(
      0 0,
      50% var(--notch),
      100% 0,
      100% calc(100% - var(--notch)),
      50% 100%,
      0 calc(100% - var(--notch))
    );
  }
  /* Pull each step up by the notch so the one above points into it. */
  .how-step + .how-step { margin-top: calc(var(--notch) * -1); }

  .how-chev h3 {
    font-size: 1.05rem;
    margin: 0;
    color: inherit;
  }
  .how-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
    opacity: 0.7;
    color: inherit;
  }
  .how-note { padding-top: 12px; }
  .how-note p {
    font-size: 0.925rem;
    line-height: 1.65;
    color: inherit;
