    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    paint-order: stroke fill;
    stroke: var(--cst-bg);
    stroke-width: 5px;
    stroke-linejoin: round;
