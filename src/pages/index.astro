    border-bottom: 1px solid var(--border);
  }
  /* The steps are chevrons that nest into each other. Stacked, the whole step is
     the chevron with its copy inside, so consecutive steps interlock; in a row,
     the shape is just the heading band and the copy sits below it.
     The fills are fixed hex rather than tokens because they are saturated brand
     colors that read on either theme, which also fixes the text color per step. */
  .how-chain-wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }
  @media (min-width: 768px) { .how-chain-wrap { padding: 0 40px; } }
  .how-chain {
    display: flex;
    flex-direction: column;
    gap: 0;
